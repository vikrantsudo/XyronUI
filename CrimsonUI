            local selected = options[1] or "Select..."
            local hasDesc = description and description ~= ""
            local baseHeight = hasDesc and 58 or 39

            local Box = CreateBox(baseHeight)
            Box.ClipsDescendants = true

            local HeaderButton = Instance.new("TextButton")
            HeaderButton.Size = UDim2.new(1, 0, 0, baseHeight)
            HeaderButton.BackgroundTransparency = 1
            HeaderButton.Text = ""
            HeaderButton.Parent = Box

            local Label = Instance.new("TextLabel")
            Label.Name = "ItemTitle"
            Label.Size = UDim2.new(0.43, 0, 0, 20)
            Label.Position = UDim2.new(0, 12, 0, hasDesc and 6 or 9)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = COLORS.Text
            Label.Font = Enum.Font.GothamBold
            Label.TextSize = 10
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = HeaderButton

            Description(Box, description, 27)

            local Selected = Instance.new("TextLabel")
            Selected.Size = UDim2.new(0.45, -5, 0, 20)
            Selected.Position = UDim2.new(0.43, 0, 0, hasDesc and 6 or 9)
            Selected.BackgroundTransparency = 1
            Selected.Text = selected
            Selected.TextColor3 = COLORS.Crimson
            Selected.Font = Enum.Font.GothamBold
            Selected.TextSize = 10
            Selected.TextXAlignment = Enum.TextXAlignment.Right
            Selected.TextTruncate = Enum.TextTruncate.AtEnd
            Selected.Parent = HeaderButton

            local Arrow = Instance.new("TextLabel")
            Arrow.Size = UDim2.new(0, 20, 0, 20)
            Arrow.Position = UDim2.new(1, -25, 0, hasDesc and 6 or 9)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = COLORS.SubText
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 8
            Arrow.Parent = HeaderButton

            local List = Instance.new("Frame")
            List.Size = UDim2.new(1, -24, 0, #options * 29)
            List.Position = UDim2.new(0, 12, 0, baseHeight)
            List.BackgroundTransparency = 1
            List.Parent = Box

            local Layout = Instance.new("UIListLayout")
            Layout.Padding = UDim.new(0, 4)
            Layout.Parent = List

            local Buttons = {}

            for _, option in ipairs(options) do
                local Option = Instance.new("TextButton")
                Option.Size = UDim2.new(1, 0, 0, 25)
                Option.BackgroundColor3 = option == selected and Color3.fromRGB(42, 16, 24) or COLORS.ElementDark
                Option.BorderSizePixel = 0
                Option.Text = ""
                Option.AutoButtonColor = false
                Option.Parent = List

                Corner(Option, 7)

                local Bar = Instance.new("Frame")
                Bar.Size = UDim2.new(0, 3, 0, 15)
                Bar.Position = UDim2.new(0, 5, 0.5, -7)
                Bar.BackgroundColor3 = COLORS.Crimson
                Bar.BorderSizePixel = 0
                Bar.Visible = option == selected
                Bar.Parent = Option

                Corner(Bar, 2)

                local OptionText = Instance.new("TextLabel")
                OptionText.Size = UDim2.new(1, -20, 1, 0)
                OptionText.Position = UDim2.new(0, 15, 0, 0)
                OptionText.BackgroundTransparency = 1
                OptionText.Text = option
                OptionText.TextColor3 = option == selected and COLORS.White or COLORS.SubText
                OptionText.Font = Enum.Font.GothamMedium
                OptionText.TextSize = 10
                OptionText.TextXAlignment = Enum.TextXAlignment.Left
                OptionText.Parent = Option

                Buttons[option] = { Button = Option, Bar = Bar, Text = OptionText }

                Option.MouseButton1Click:Connect(function()
                    selected = option
                    Selected.Text = option
                    opened = false

                    for _, data in pairs(Buttons) do
                        data.Bar.Visible = false
                        data.Text.TextColor3 = COLORS.SubText
                        Tween(data.Button, 0.12, { BackgroundColor3 = COLORS.ElementDark })
                    end

                    Buttons[option].Bar.Visible = true
                    Buttons[option].Text.TextColor3 = COLORS.White
                    Tween(Buttons[option].Button, 0.12, { BackgroundColor3 = Color3.fromRGB(42, 16, 24) })
                    Tween(Box, 0.22, { Size = UDim2.new(1, 0, 0, baseHeight) })
                    Tween(Arrow, 0.18, { Rotation = 0 })

                    if callback then
                        callback(option)
                    end
                end)
            end

            HeaderButton.MouseButton1Click:Connect(function()
                opened = not opened
                local height = opened and baseHeight + 6 + (#options * 29) or baseHeight
                Tween(Box, 0.22, { Size = UDim2.new(1, 0, 0, height) })
                Tween(Arrow, 0.18, { Rotation = opened and 180 or 0 })
            end)
        end

        -- Multi Dropdown
        function Tab:AddMultiDropdown(text, options, callback, description)
            options = options or {}
            local opened = false
            local selected = {}
            local hasDesc = description and description ~= ""
            local baseHeight = hasDesc and 58 or 39

            local Box = CreateBox(baseHeight)
            Box.ClipsDescendants = true

            local HeaderButton = Instance.new("TextButton")
            HeaderButton.Size = UDim2.new(1, 0, 0, baseHeight)
            HeaderButton.BackgroundTransparency = 1
            HeaderButton.Text = ""
            HeaderButton.Parent = Box

            local Label = Instance.new("TextLabel")
            Label.Name = "ItemTitle"
            Label.Size = UDim2.new(0.45, 0, 0, 20)
            Label.Position = UDim2.new(0, 12, 0, hasDesc and 6 or 9)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = COLORS.Text
            Label.Font = Enum.Font.GothamBold
            Label.TextSize = 10
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.Parent = HeaderButton

            Description(Box, description, 27)

            local Selected = Instance.new("TextLabel")
            Selected.Size = UDim2.new(0.45, -5, 0, 20)
            Selected.Position = UDim2.new(0.43, 0, 0, hasDesc and 6 or 9)
            Selected.BackgroundTransparency = 1
            Selected.Text = "None"
            Selected.TextColor3 = COLORS.Crimson
            Selected.Font = Enum.Font.GothamBold
            Selected.TextSize = 10
            Selected.TextXAlignment = Enum.TextXAlignment.Right
            Selected.TextTruncate = Enum.TextTruncate.AtEnd
            Selected.Parent = HeaderButton

            local Arrow = Instance.new("TextLabel")
            Arrow.Size = UDim2.new(0, 20, 0, 20)
            Arrow.Position = UDim2.new(1, -25, 0, hasDesc and 6 or 9)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = COLORS.SubText
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 8
            Arrow.Parent = HeaderButton

            local List = Instance.new("Frame")
            List.Size = UDim2.new(1, -24, 0, #options * 30)
            List.Position = UDim2.new(0, 12, 0, baseHeight)
            List.BackgroundTransparency = 1
            List.Parent = Box

            local Layout = Instance.new("UIListLayout")
            Layout.Padding = UDim.new(0, 4)
            Layout.Parent = List

            local function UpdateText()
                local names = {}
                for _, option in ipairs(options) do
                    if selected[option] then
                        table.insert(names, option)
                    end
                end

                if #names == 0 then
                    Selected.Text = "None"
                elseif #names <= 2 then
                    Selected.Text = table.concat(names, ", ")
                else
                    Selected.Text = tostring(#names) .. " selected"
                end
            end

            for _, option in ipairs(options) do
                selected[option] = false

                local Option = Instance.new("TextButton")
                Option.Size = UDim2.new(1, 0, 0, 26)
                Option.BackgroundColor3 = COLORS.ElementDark
                Option.BorderSizePixel = 0
                Option.Text = ""
                Option.AutoButtonColor = false
                Option.Parent = List

                Corner(Option, 7)

                local Indicator = Instance.new("Frame")
                Indicator.Size = UDim2.new(0, 3, 0, 16)
                Indicator.Position = UDim2.new(0, 5, 0.5, -8)
                Indicator.BackgroundColor3 = COLORS.Crimson
                Indicator.BorderSizePixel = 0
                Indicator.Visible = false
                Indicator.Parent = Option

                Corner(Indicator, 2)

                local OptionText = Instance.new("TextLabel")
                OptionText.Size = UDim2.new(1, -25, 1, 0)
                OptionText.Position = UDim2.new(0, 16, 0, 0)
                OptionText.BackgroundTransparency = 1
                OptionText.Text = option
                OptionText.TextColor3 = COLORS.SubText
                OptionText.Font = Enum.Font.GothamMedium
                OptionText.TextSize = 10
                OptionText.TextXAlignment = Enum.TextXAlignment.Left
                OptionText.Parent = Option

                Option.MouseButton1Click:Connect(function()
                    selected[option] = not selected[option]

                    if selected[option] then
                        Indicator.Visible = true
                        Tween(Option, 0.15, { BackgroundColor3 = Color3.fromRGB(42, 16, 24) })
                        Tween(OptionText, 0.15, { TextColor3 = COLORS.White })
                    else
                        Indicator.Visible = false
                        Tween(Option, 0.15, { BackgroundColor3 = COLORS.ElementDark })
                        Tween(OptionText, 0.15, { TextColor3 = COLORS.SubText })
                    end

                    UpdateText()

                    if callback then
                        callback(selected)
                    end
                end)
            end

            HeaderButton.MouseButton1Click:Connect(function()
                opened = not opened
                local height = opened and baseHeight + 6 + (#options * 30) or baseHeight
                Tween(Box, 0.22, { Size = UDim2.new(1, 0, 0, height) })
                Tween(Arrow, 0.18, { Rotation = opened and 180 or 0 })
            end)
        end

        return Tab
    end

    --==========================================================
    -- FLOATING MINIMIZED BUTTON
    --==========================================================

    local Floating = Instance.new("ImageButton")
    Floating.Name = "FloatingIcon"
    Floating.Size = UDim2.new(0, 54, 0, 54)
    Floating.Position = UDim2.new(0.05, 0, 0.25, 0)
    Floating.BackgroundColor3 = COLORS.Header
    Floating.BorderSizePixel = 0
    Floating.Image = windowIcon
    Floating.ScaleType = Enum.ScaleType.Fit
    Floating.Visible = false
    Floating.Parent = ScreenGui

    Corner(Floating, 15)
    Stroke(Floating, COLORS.Crimson, 0.2, 1.5)

    MakeDraggable(Floating, Floating)

    Minimize.MouseButton1Click:Connect(function()
        MainFrame.Visible = false
        Floating.Visible = true
    end)

    Floating.MouseButton1Click:Connect(function()
        MainFrame.Visible = true
        Floating.Visible = false
    end)

    Close.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    return Window
end

return Library
