		}, 0.3):Play()

		task.wait(0.35)

		Loading:Destroy()

		Main.Visible = true

		Main.Size = UDim2.new(
			0,
			Size.X.Offset,
			0,
			0
		)

		Main.BackgroundTransparency = 1
		MainStroke.Transparency = 1

		Tween(Main, {
			Size = fullSize,
			BackgroundTransparency = 0
		}, 0.4):Play()

		Tween(MainStroke, {
			Transparency = 0.35
		}, 0.4):Play()

