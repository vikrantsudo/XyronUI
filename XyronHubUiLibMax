		--==================================================

		function Tab:CreateSlider(config)

			config = config or {}

			local Flag = config.Flag or config.Name

			local Min = config.Min or 0
			local Max = config.Max or 100

			Window.Flags[Flag] = config.Default or Min

			local Frame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 48),
				BackgroundColor3 = Theme.Background2,
				Parent = Page
			})

			Create("UICorner", {
				CornerRadius = UDim.new(0, 7),
				Parent = Frame
			})

			Create("UIStroke", {
				Color = Theme.Stroke,
				Thickness = 1,
				Transparency = 0.55,
				Parent = Frame
			})

			Create("TextLabel", {
				Size = UDim2.new(0.65, 0, 0, 16),
				Position = UDim2.new(0, 10, 0, 5),
				BackgroundTransparency = 1,
				Text = config.Name or "Slider",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Frame
			})

			local ValueLabel = Create("TextLabel", {
				Size = UDim2.new(0.3, -8, 0, 16),
				Position = UDim2.new(0.7, 0, 0, 5),
				BackgroundTransparency = 1,
				Text = tostring(Window.Flags[Flag]),
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = Theme.Accent,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = Frame
			})

			local BarBg = Create("Frame", {
				Size = UDim2.new(1, -20, 0, 5),
				Position = UDim2.new(0, 10, 0, 30),
				BackgroundColor3 = Theme.Background3,
				Parent = Frame
			})

			Create("UICorner", {
				CornerRadius = UDim.new(1, 0),
				Parent = BarBg
			})

			local initialPercent = 0

			if Max ~= Min then
				initialPercent =
					math.clamp(
						(Window.Flags[Flag] - Min) / (Max - Min),
						0,
						1
					)
			end

			local Fill = Create("Frame", {
				Size = UDim2.new(initialPercent, 0, 1, 0),
				BackgroundColor3 = Theme.Accent,
				Parent = BarBg
			})

			Create("UICorner", {
				CornerRadius = UDim.new(1, 0),
				Parent = Fill
			})

			local sliding = false

			BarBg.InputBegan:Connect(function(input)

				if IsInput(input) then
					sliding = true
				end

			end)

			UserInputService.InputEnded:Connect(function(input)

				if IsInput(input) then
					sliding = false
				end

			end)

			UserInputService.InputChanged:Connect(function(input)

				if sliding and IsMoveInput(input) then

					local rel = math.clamp(
						(input.Position.X - BarBg.AbsolutePosition.X)
							/ BarBg.AbsoluteSize.X,
						0,
						1
					)

					local val = math.floor(
						Min + (Max - Min) * rel
					)

					Window.Flags[Flag] = val

					Fill.Size = UDim2.new(
						rel,
						0,
						1,
						0
					)

					ValueLabel.Text = tostring(val)

					if config.Callback then
						config.Callback(val)
					end

				end

			end)

			table.insert(Window.AllElements, {
				Frame = Frame,
				Name = config.Name or "Slider",
				Tab = name
			})

			return Frame

		end

