	task.spawn(function()
		task.wait(1.0)
		Tween(Loading, {BackgroundTransparency = 1}, 0.3):Play()
		Tween(LoadStroke, {Transparency = 1}, 0.3):Play()
		Tween(LoadTitle, {TextTransparency = 1}, 0.3):Play()
		Tween(LoadSub, {TextTransparency = 1}, 0.3):Play()
		task.wait(0.35)
		Loading:Destroy()

		Main.Visible = true
		Main.Size = UDim2.new(0, Size.X.Offset, 0, 0)
		Main.BackgroundTransparency = 1
		MainStroke.Transparency = 1

		Tween(Main, {Size = fullSize, BackgroundTransparency = 0}, 0.4):Play()
		Tween(MainStroke, {Transparency = 0.35}, 0.4):Play()

		task.wait(0.2)
		Library:Notify({
			Title = Title .. " Loaded",
			Content = "Ready to use",
			Duration = 3
		})
	end)

	return Window
end

return Library
