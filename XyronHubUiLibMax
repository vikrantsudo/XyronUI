	function Library:Notify(config)
		config = config or {}
		local Title = config.Title or "Notification"
		local Content = config.Content or ""
		local Duration = config.Duration or 3

		local Notif = Create("Frame", {
			Size = UDim2.new(0, 210, 0, 52),
			BackgroundColor3 = Theme.Background2,
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			Parent = NotifHolder
		})
		Create("UICorner", {CornerRadius = UDim.new(0, 9), Parent = Notif})
		local Ns = Create("UIStroke", {Color = Theme.Accent, Thickness = 1, Transparency = 1, Parent = Notif})

		local T = Create("TextLabel", {
			Size = UDim2.new(1, -14, 0, 18),
			Position = UDim2.new(0, 10, 0, 7),
			BackgroundTransparency = 1,
			Text = Title,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = Theme.Text,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = Notif
		})
		local C = Create("TextLabel", {
			Size = UDim2.new(1, -14, 0, 14),
			Position = UDim2.new(0, 10, 0, 27),
			BackgroundTransparency = 1,
			Text = Content,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextColor3 = Theme.TextDim,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = Notif
		})

		local Line = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 2),
			Position = UDim2.new(0, 0, 1, -2),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			Parent = Notif
		})
		Create("UICorner", {CornerRadius = UDim.new(0, 1), Parent = Line})

		Tween(Notif, {BackgroundTransparency = 0}, 0.3):Play()
		Tween(Ns, {Transparency = 0.4}, 0.3):Play()
		Tween(T, {TextTransparency = 0}, 0.3):Play()
		Tween(C, {TextTransparency = 0}, 0.3):Play()
		Tween(Line, {Size = UDim2.new(0, 0, 0, 2)}, Duration):Play()

		task.delay(Duration + 0.1, function()
			Tween(Notif, {BackgroundTransparency = 1}, 0.3):Play()
			Tween(Ns, {Transparency = 1}, 0.3):Play()
			Tween(T, {TextTransparency = 1}, 0.3):Play()
			Tween(C, {TextTransparency = 1}, 0.3):Play()
			task.wait(0.35)
			Notif:Destroy()
		end)
	end

