		Tween(Main, {
			Size = UDim2.new(
				0,
				Size.X.Offset,
				0,
				0
			),
			BackgroundTransparency = 1
		}, 0.22):Play()

		task.wait(0.25)

		if ScreenGui then
			ScreenGui:Destroy()
		end

	end)

	--==================================================
	-- FPS / PING / UPTIME
	--==================================================

	local startTime = tick()
	local frames = 0

	RunService.RenderStepped:Connect(function()
		frames += 1
	end)

	task.spawn(function()

		while ScreenGui.Parent do

			task.wait(1)

			local fps = frames
			frames = 0

			local ping = 0

			pcall(function()

				ping = math.floor(
					Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
				)

			end)

			local uptime = math.floor(tick() - startTime)

			local uptimeString = string.format(
				"%dm %02ds",
				math.floor(uptime / 60),
				uptime % 60
			)

			StatusText.Text = string.format(
				"FPS: %d  |  Ping: %dms",
				fps,
				ping
			)

			MinStats.Text = string.format(
				"FPS %d\nPing %dms\nUp %s",
				fps,
				ping,
				uptimeString
			)

		end

	end)

	--==================================================
	-- SEARCH
	--==================================================

	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()

		local query = string.lower(SearchBox.Text)

		for _, element in ipairs(Window.AllElements) do

			if element.Tab == Window.CurrentTab then

				element.Frame.Visible =
					query == ""
					or string.find(
						string.lower(element.Name),
						query,
						1,
						true
					) ~= nil

			end

		end

	end)

	--==================================================
	-- CREATE TAB
	--==================================================

	function Window:CreateTab(name)

		local TabBtn = Create("TextButton", {
			Size = UDim2.new(0, 70, 0, 24),
			BackgroundColor3 = Theme.Background3,
			Text = name,
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = Theme.TextDim,
			AutoButtonColor = false,
			Parent = TabList
		})

		Create("UICorner", {
			CornerRadius = UDim.new(0, 5),
			Parent = TabBtn
		})

		local Page = Create("Frame", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = FeatureList
		})

		local PageLayout = Create("UIListLayout", {
			Padding = UDim.new(0, 7),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = Page
		})

		PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()

			Page.Size = UDim2.new(
				1,
				0,
				0,
				PageLayout.AbsoluteContentSize.Y
			)

		end)

		local Tab = {
			Name = name,
			Button = TabBtn,
			Page = Page
		}

		TabBtn.MouseButton1Click:Connect(function()

			if Window.CurrentTab == name then
				return
			end

			if Window.CurrentTab
				and Window.Tabs[Window.CurrentTab] then

				local oldTab = Window.Tabs[Window.CurrentTab]

				oldTab.Button.BackgroundColor3 = Theme.Background3
				oldTab.Button.TextColor3 = Theme.TextDim
				oldTab.Page.Visible = false

			end

			Window.CurrentTab = name

			TabBtn.BackgroundColor3 = Theme.Accent
			TabBtn.TextColor3 = Color3.new(1, 1, 1)

			Page.Visible = true

			SearchBox.Text = ""

			for _, element in ipairs(Window.AllElements) do

				if element.Tab == name then
					element.Frame.Visible = true
				end

			end

		end)

		if not Window.CurrentTab then

			Window.CurrentTab = name

			TabBtn.BackgroundColor3 = Theme.Accent
			TabBtn.TextColor3 = Color3.new(1, 1, 1)

			Page.Visible = true

		end

		Window.Tabs[name] = Tab

		--==================================================
		-- SECTION
		--==================================================

		function Tab:CreateSection(text)

			local Section = Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				Text = text,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextColor3 = Theme.Accent,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Page
			})

			return Section

		end

		--==================================================
		-- DIVIDER
		--==================================================

		function Tab:CreateDivider()

			return Create("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = Theme.Stroke,
				Parent = Page
			})

		end

		--==================================================
		-- LABEL
		--==================================================

		function Tab:CreateLabel(text)

			local Label = Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				Text = text,
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextColor3 = Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Page
			})

			table.insert(Window.AllElements, {
				Frame = Label,
				Name = text,
				Tab = name
			})

			return Label

		end

		--==================================================
		-- BUTTON
		--==================================================

		function Tab:CreateButton(config)

			config = config or {}

			local Button = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 34),
				BackgroundColor3 = Theme.Background2,
				Text = config.Name or "Button",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = config.Danger
					and Theme.Danger
					or Theme.Text,
				AutoButtonColor = false,
				Parent = Page
			})

			Create("UICorner", {
				CornerRadius = UDim.new(0, 7),
				Parent = Button
			})

			Create("UIStroke", {
				Color = Theme.Stroke,
				Thickness = 1,
				Transparency = 0.55,
				Parent = Button
			})

			Button.MouseEnter:Connect(function()

				Tween(Button, {
					BackgroundColor3 = Theme.Background3
				}, 0.12):Play()

			end)

			Button.MouseLeave:Connect(function()

				Tween(Button, {
					BackgroundColor3 = Theme.Background2
				}, 0.12):Play()

			end)

			Button.MouseButton1Click:Connect(function()

				if config.Callback then
					config.Callback()
				end

			end)

			table.insert(Window.AllElements, {
				Frame = Button,
				Name = config.Name or "Button",
				Tab = name
			})

			return Button

		end

		--==================================================
		-- TOGGLE
		--==================================================

		function Tab:CreateToggle(config)

			config = config or {}

			local Flag = config.Flag or config.Name

			Window.Flags[Flag] = config.Default or false

