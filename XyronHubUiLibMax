			Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = DropBtn})

			local Open = false
			local ListFrame = Create("Frame", {
				Size = UDim2.new(1, -12, 0, #Options * 28),
				Position = UDim2.new(0, 6, 0, 40),
				BackgroundColor3 = Theme.Background3,
				BorderSizePixel = 0,
				Visible = false,
				Parent = Frame
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ListFrame})

			local function Refresh()
				if Multi then
					DropBtn.Text = #Window.Flags[Flag] .. " selected  ▼"
				else
					DropBtn.Text = tostring(Window.Flags[Flag]) .. "  ▼"
				end
			end

			for i, opt in ipairs(Options) do
				local Row = Create("TextButton", {
					Size = UDim2.new(1, 0, 0, 28),
					Position = UDim2.new(0, 0, 0, (i-1)*28),
					BackgroundTransparency = 1,
					Text = "",
					Parent = ListFrame
				})

				local Indicator = Create("TextLabel", {
					Size = UDim2.new(0, 18, 1, 0),
					Position = UDim2.new(0, 8, 0, 0),
					BackgroundTransparency = 1,
					Text = (Multi and table.find(Window.Flags[Flag], opt)) and "●" or (not Multi and Window.Flags[Flag] == opt) and "●" or "○",
					Font = Enum.Font.GothamBold,
					TextSize = 12,
					TextColor3 = (Multi and table.find(Window.Flags[Flag], opt) or (not Multi and Window.Flags[Flag] == opt)) and Theme.Accent or Theme.TextDim,
					Parent = Row
				})

				Create("TextLabel", {
					Size = UDim2.new(1, -30, 1, 0),
					Position = UDim2.new(0, 28, 0, 0),
					BackgroundTransparency = 1,
					Text = opt,
					Font = Enum.Font.Gotham,
					TextSize = 12,
					TextColor3 = Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Row
				})

				Row.MouseButton1Click:Connect(function()
					if Multi then
						local idx = table.find(Window.Flags[Flag], opt)
						if idx then
							table.remove(Window.Flags[Flag], idx)
							Indicator.Text = "○"
							Indicator.TextColor3 = Theme.TextDim
						else
							table.insert(Window.Flags[Flag], opt)
							Indicator.Text = "●"
							Indicator.TextColor3 = Theme.Accent
						end
					else
						Window.Flags[Flag] = opt
						for _, child in ipairs(ListFrame:GetChildren()) do
							if child:IsA("TextButton") then
								local ind = child:FindFirstChildOfClass("TextLabel")
								if ind then
									ind.Text = "○"
									ind.TextColor3 = Theme.TextDim
								end
							end
						end
						Indicator.Text = "●"
						Indicator.TextColor3 = Theme.Accent
						Open = false
						ListFrame.Visible = false
						Frame.Size = UDim2.new(1, 0, 0, 38)
					end
					Refresh()
					if config.Callback then config.Callback(Window.Flags[Flag]) end
				end)
			end

			DropBtn.MouseButton1Click:Connect(function()
				Open = not Open
				ListFrame.Visible = Open
				Frame.Size = Open and UDim2.new(1, 0, 0, 40 + #Options * 28 + 6) or UDim2.new(1, 0, 0, 38)
			end)

			table.insert(Window.AllElements, {Frame = Frame, Name = config.Name or "Dropdown", Tab = name})
			return Frame
		end

