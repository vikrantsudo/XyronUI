			})

			Create("UICorner", {
				CornerRadius = UDim.new(0, 7),
				Parent = Frame
			})

			Create("UIStroke", {
				Color = Theme.Stroke,
				Thickness = 1,
				Transparency = 0.55,
				Parent = Frame
			})

			Create("TextLabel", {
				Size = UDim2.new(0.4, 0, 1, 0),
				Position = UDim2.new(0, 10, 0, 0),
				BackgroundTransparency = 1,
				Text = config.Name or "Dropdown",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Frame
			})

			local DropBtn = Create("TextButton", {
				Size = UDim2.new(0.55, -12, 0, 24),
				Position = UDim2.new(0.42, 0, 0.5, -12),
				BackgroundColor3 = Theme.Background3,
				Text = Multi
					and (#Window.Flags[Flag] .. " selected ▼")
					or (tostring(Window.Flags[Flag]) .. " ▼"),
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = Theme.Text,
				AutoButtonColor = false,
				Parent = Frame
			})

			Create("UICorner", {
				CornerRadius = UDim.new(0, 5),
				Parent = DropBtn
			})

			local Open = false

			local ListFrame = Create("Frame", {
				Size = UDim2.new(
					1,
					-12,
					0,
					#Options * 28
				),
				Position = UDim2.new(0, 6, 0, 40),
				BackgroundColor3 = Theme.Background3,
				Visible = false,
				Parent = Frame
			})

			Create("UICorner", {
				CornerRadius = UDim.new(0, 6),
				Parent = ListFrame
			})

			local function Refresh()

				if Multi then
					DropBtn.Text =
						#Window.Flags[Flag]
						.. " selected ▼"
				else
					DropBtn.Text =
						tostring(Window.Flags[Flag])
						.. " ▼"
				end

			end

			for i, opt in ipairs(Options) do

				local Row = Create("TextButton", {
					Size = UDim2.new(1, 0, 0, 28),
					Position = UDim2.new(
						0,
						0,
						0,
						(i - 1) * 28
					),
					BackgroundTransparency = 1,
					Text = "",
					Parent = ListFrame
				})

				local selected =
					Multi
					and table.find(Window.Flags[Flag], opt)
					or (
						not Multi
						and Window.Flags[Flag] == opt
					)

				local Indicator = Create("TextLabel", {
					Size = UDim2.new(0, 18, 1, 0),
					Position = UDim2.new(0, 8, 0, 0),
					BackgroundTransparency = 1,
					Text = selected and "●" or "○",
					Font = Enum.Font.GothamBold,
					TextSize = 12,
					TextColor3 =
						selected
						and Theme.Accent
						or Theme.TextDim,
					Parent = Row
				})

				Create("TextLabel", {
					Size = UDim2.new(1, -30, 1, 0),
					Position = UDim2.new(0, 28, 0, 0),
					BackgroundTransparency = 1,
					Text = tostring(opt),
					Font = Enum.Font.Gotham,
					TextSize = 12,
					TextColor3 = Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Row
				})

				Row.MouseButton1Click:Connect(function()

					if Multi then

						local index =
							table.find(
								Window.Flags[Flag],
								opt
							)

						if index then

							table.remove(
								Window.Flags[Flag],
								index
							)

							Indicator.Text = "○"
							Indicator.TextColor3 =
								Theme.TextDim

						else

							table.insert(
								Window.Flags[Flag],
								opt
							)

							Indicator.Text = "●"
							Indicator.TextColor3 =
								Theme.Accent

						end

					else

						Window.Flags[Flag] = opt

						for _, child in ipairs(
							ListFrame:GetChildren()
						) do

							if child:IsA("TextButton") then

								local indicator =
									child:FindFirstChild(
										"TextLabel"
									)

								if indicator then
									indicator.Text = "○"
									indicator.TextColor3 =
										Theme.TextDim
								end

							end

						end

						Indicator.Text = "●"
						Indicator.TextColor3 =
							Theme.Accent

						Open = false
						ListFrame.Visible = false

						Frame.Size =
							UDim2.new(
								1,
								0,
								0,
								38
							)

					end

					Refresh()

					if config.Callback then
						config.Callback(
							Window.Flags[Flag]
						)
					end

				end)

			end

			DropBtn.MouseButton1Click:Connect(function()

				Open = not Open

				ListFrame.Visible = Open

				Frame.Size =
					Open
					and UDim2.new(
						1,
						0,
						0,
						40 + #Options * 28 + 6
					)
					or UDim2.new(
						1,
						0,
						0,
						38
					)

			end)

			table.insert(Window.AllElements, {
				Frame = Frame,
				Name = config.Name or "Dropdown",
				Tab = name
			})

			return Frame

		end

