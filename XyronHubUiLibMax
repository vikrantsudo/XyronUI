			TextSize = 11,
			TextColor3 = Theme.TextDim,
			TextTransparency = 1,
			TextXAlignment =
				Enum.TextXAlignment.Left,
			Parent = Notif
		})

		local Line = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 2),
			Position = UDim2.new(0, 0, 1, -2),
			BackgroundColor3 = Theme.Accent,
			Parent = Notif
		})

		Tween(Notif, {
			BackgroundTransparency = 0
		}, 0.3):Play()

		Tween(Stroke, {
			Transparency = 0.4
		}, 0.3):Play()

		Tween(TitleLabel, {
			TextTransparency = 0
		}, 0.3):Play()

		Tween(ContentLabel, {
			TextTransparency = 0
		}, 0.3):Play()

		Tween(Line, {
			Size = UDim2.new(0, 0, 0, 2)
		}, duration):Play()

		task.delay(duration + 0.1, function()

			Tween(Notif, {
				BackgroundTransparency = 1
			}, 0.3):Play()

			Tween(Stroke, {
				Transparency = 1
			}, 0.3):Play()

			Tween(TitleLabel, {
				TextTransparency = 1
			}, 0.3):Play()

			Tween(ContentLabel, {
				TextTransparency = 1
			}, 0.3):Play()

			task.wait(0.35)

			if Notif then
				Notif:Destroy()
			end

		end)

	end

