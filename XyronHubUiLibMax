	-- FINAL LOAD ANIMATION
	--==================================================

	task.spawn(function()

		task.wait(0.9)

		Tween(Loading, {
			BackgroundTransparency = 1
		}, 0.3):Play()

		Tween(LoadStroke, {
			Transparency = 1
		}, 0.3):Play()

		Tween(LoadTitle, {
			TextTransparency = 1
		}, 0.3):Play()

		Tween(LoadSub, {
