		ZIndex = 50,
		Parent = ScreenGui
	})
	Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Tooltip})
	Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Parent = Tooltip})

	local TipText = Create("TextLabel", {
		Size = UDim2.new(1, -10, 1, 0),
		Position = UDim2.new(0, 5, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = Theme.Text,
		TextWrapped = true,
		Parent = Tooltip
	})

	local function ShowTooltip(gui, text)
		TipText.Text = text
		Tooltip.Visible = true
		local p = gui.AbsolutePosition
		Tooltip.Position = UDim2.new(0, p.X, 0, p.Y - 38)
	end
	local function HideTooltip()
		Tooltip.Visible = false
	end

	-- Window Object
	local Window = {}
	Window.Tabs = {}
	Window.CurrentTab = nil
	Window.AllElements = {}
	Window.Flags = {}

	-- Dragging
	local dragging, dragStart, startPos
	TitleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = Main.Position
		end
	end)
	TitleBar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	-- Minimize / Close
	local minimized = false
	local fullSize = Size
	local miniSize = UDim2.new(0, 280, 0, 46)

	MinimizeBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			MaxContent.Visible = false
			MinContent.Visible = true
			Body.Visible = false
			Tween(Main, {Size = miniSize}, 0.28):Play()
		else
			MinContent.Visible = false
			MaxContent.Visible = true
			Body.Visible = true
			Tween(Main, {Size = fullSize}, 0.32):Play()
		end
	end)

	CloseBtn.MouseButton1Click:Connect(function()
		Tween(Main, {Size = UDim2.new(0, Size.X.Offset, 0, 0), BackgroundTransparency = 1}, 0.22):Play()
		task.wait(0.25)
		ScreenGui:Destroy()
	end)

	-- Hover effects
	local function AddHover(btn, normal, hover)
		btn.MouseEnter:Connect(function() Tween(btn, {BackgroundColor3 = hover}, 0.12):Play() end)
		btn.MouseLeave:Connect(function() Tween(btn, {BackgroundColor3 = normal}, 0.12):Play() end)
	end
	AddHover(MinimizeBtn, Theme.Background3, Color3.fromRGB(42, 42, 55))
	AddHover(CloseBtn, Theme.Background3, Color3.fromRGB(55, 28, 38))

	-- FPS / Ping / Uptime
	local startTime = tick()
	local fps, frames = 0, 0
	RunService.RenderStepped:Connect(function() frames += 1 end)

	task.spawn(function()
		while task.wait(1) do
			fps = frames
			frames = 0
			local ping = 0
			pcall(function()
				ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
			end)
			local uptime = math.floor(tick() - startTime)
			local mins = math.floor(uptime / 60)
			local secs = uptime % 60
			local upStr = string.format("%dm %02ds", mins, secs)

			StatusText.Text = string.format("FPS: %d  |  Ping: %dms", fps, ping)
			MinStats.Text = string.format("FPS %d\nPing %dms\nUp %s", fps, ping, upStr)
		end
	end)

	-- Search
	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local q = string.lower(SearchBox.Text)
		for _, el in ipairs(Window.AllElements) do
			if el.Tab == Window.CurrentTab then
				el.Frame.Visible = (q == "" or string.find(string.lower(el.Name), q, 1, true))
			end
		end
	end)

	--==============================
	-- TAB
	--==============================
	function Window:CreateTab(name)
		local TabBtn = Create("TextButton", {
			Size = UDim2.new(0, 70, 0, 24),
			BackgroundColor3 = Theme.Background3,
			Text = name,
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = Theme.TextDim,
			AutoButtonColor = false,
			Parent = TabList
		})
		Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = TabBtn})

		local Page = Create("Frame", {
			Name = name,
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			Visible = false,
			Parent = FeatureList
		})
		local PageLayout = Create("UIListLayout", {
			Padding = UDim.new(0, 7),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = Page
		})
		PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			Page.Size = UDim2.new(1, 0, 0, PageLayout.AbsoluteContentSize.Y)
		end)

		local Tab = {}
		Tab.Name = name
		Tab.Button = TabBtn
		Tab.Page = Page
		Tab.Elements = {}

		TabBtn.MouseButton1Click:Connect(function()
			if Window.CurrentTab == name then return end
			if Window.CurrentTab and Window.Tabs[Window.CurrentTab] then
				local old = Window.Tabs[Window.CurrentTab]
				old.Button.BackgroundColor3 = Theme.Background3
				old.Button.TextColor3 = Theme.TextDim
				old.Page.Visible = false
			end
			Window.CurrentTab = name
			TabBtn.BackgroundColor3 = Theme.Accent
			TabBtn.TextColor3 = Color3.new(1, 1, 1)
			Page.Visible = true
			SearchBox.Text = ""
			for _, el in ipairs(Window.AllElements) do
				if el.Tab == name then el.Frame.Visible = true end
			end
		end)

		-- Select first tab automatically
		if not Window.CurrentTab then
			Window.CurrentTab = name
			TabBtn.BackgroundColor3 = Theme.Accent
			TabBtn.TextColor3 = Color3.new(1, 1, 1)
			Page.Visible = true
		end

		Window.Tabs[name] = Tab

		--==============================
		-- COMPONENTS
		--==============================

		function Tab:CreateSection(text)
			local Section = Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				Text = text,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextColor3 = Theme.Accent,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Page
			})
			return Section
		end

		function Tab:CreateDivider()
			local Div = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = Theme.Stroke,
				BorderSizePixel = 0,
				Parent = Page
			})
			return Div
		end

		function Tab:CreateLabel(text)
			local Label = Create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				Text = text,
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextColor3 = Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Page
			})
			table.insert(Window.AllElements, {Frame = Label, Name = text, Tab = name})
			return Label
		end

		function Tab:CreateParagraph(config)
			config = config or {}
			local Frame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 60),
				BackgroundColor3 = Theme.Background2,
				BorderSizePixel = 0,
				Parent = Page
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 7), Parent = Frame})
			Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Transparency = 0.55, Parent = Frame})

			local Title = Create("TextLabel", {
				Size = UDim2.new(1, -16, 0, 18),
				Position = UDim2.new(0, 10, 0, 6),
				BackgroundTransparency = 1,
				Text = config.Title or "Paragraph",
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Frame
			})

			local Content = Create("TextLabel", {
				Size = UDim2.new(1, -16, 0, 30),
				Position = UDim2.new(0, 10, 0, 26),
				BackgroundTransparency = 1,
				Text = config.Content or "",
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				Parent = Frame
			})

			table.insert(Window.AllElements, {Frame = Frame, Name = config.Title or "Paragraph", Tab = name})
			return Frame
		end

		function Tab:CreateButton(config)
			config = config or {}
			local Btn = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 34),
				BackgroundColor3 = Theme.Background2,
				Text = config.Name or "Button",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = config.Danger and Theme.Danger or Theme.Text,
				AutoButtonColor = false,
				Parent = Page
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 7), Parent = Btn})
			Create("UIStroke", {Color = Theme.Stroke, Thickness = 1, Transparency = 0.55, Parent = Btn})

			Btn.MouseEnter:Connect(function()
				Tween(Btn, {BackgroundColor3 = Theme.Background3}, 0.12):Play()
			end)
			Btn.MouseLeave:Connect(function()
				Tween(Btn, {BackgroundColor3 = Theme.Background2}, 0.12):Play()
			end)
			Btn.MouseButton1Click:Connect(function()
				if config.Callback then config.Callback() end
			end)

			table.insert(Window.AllElements, {Frame = Btn, Name = config.Name or "Button", Tab = name})
			return Btn
		end

		function Tab:CreateToggle(config)
			config = config or {}
			local Flag = config.Flag or config.Name
			Window.Flags[Flag] = config.Default or false

			local Frame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundColor3 = Theme.Background2,
				BorderSizePixel = 0,
				Parent = Page
			})
			Create("UICorner", {CornerRadius = UDim.new(0, 7), Parent = Frame})
