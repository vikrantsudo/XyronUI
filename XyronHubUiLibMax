			-- VALUE TEXT
			--==============================================

			local ValueText = Create("TextLabel", {
				Size = UDim2.new(1, -30, 1, 0),
				Position = UDim2.new(0, 8, 0, 0),
				BackgroundTransparency = 1,
				Text = "",
				Font = Enum.Font.Gotham,
				TextSize = 11,
				TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = DropBtn
			})

			--==============================================
			-- ARROW
			--==============================================

			local Arrow = Create("TextLabel", {
				Size = UDim2.new(0, 20, 1, 0),
				Position = UDim2.new(1, -22, 0, 0),
				BackgroundTransparency = 1,
				Text = "▼",
				Font = Enum.Font.GothamBold,
				TextSize = 9,
				TextColor3 = Theme.TextDim,
				Parent = DropBtn
			})

			--==============================================
			-- LIST FRAME
			--==============================================

			local ListFrame = Create("Frame", {
				Size = UDim2.new(1, -12, 0, 0),
				Position = UDim2.new(
					0,
					6,
					0,
					HEADER_HEIGHT
				),
				BackgroundColor3 = Theme.Background3,
				ClipsDescendants = true,
				Parent = Frame
			})

			Create("UICorner", {
				CornerRadius = UDim.new(0, 6),
				Parent = ListFrame
			})

			Create("UIStroke", {
				Color = Theme.Stroke,
				Thickness = 1,
				Transparency = 0.65,
				Parent = ListFrame
			})

			--==============================================
			-- OPTIONS HOLDER
			--==============================================

			local OptionsHolder = Create("Frame", {
				Size = UDim2.new(
					1,
					0,
					1,
					-FOOTER_HEIGHT
				),
				Position = UDim2.new(0, 0, 0, 0),
				BackgroundTransparency = 1,
				Parent = ListFrame
			})

			local OptionLayout = Create("UIListLayout", {
				Padding = UDim.new(0, 1),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = OptionsHolder
			})

			--==============================================
			-- COLLAPSE BUTTON
			--==============================================

			local Minimize = Create("TextButton", {
				Size = UDim2.new(1, -10, 0, 27),
				Position = UDim2.new(0, 5, 1, -30),
				BackgroundColor3 = Theme.Background2,
				Text = "Collapse  ▲",
				Font = Enum.Font.GothamMedium,
				TextSize = 10,
				TextColor3 = Theme.TextDim,
				AutoButtonColor = false,
				Parent = ListFrame
			})

			Create("UICorner", {
				CornerRadius = UDim.new(0, 5),
				Parent = Minimize
			})

			Create("UIStroke", {
				Color = Theme.Stroke,
				Thickness = 1,
				Transparency = 0.7,
				Parent = Minimize
			})

			--==============================================
			-- STATE
			--==============================================

			local Open = false

			--==============================================
			-- REFRESH
			--==============================================

			local function Refresh()

				local Count = #Window.Flags[Flag]

				if Count == 0 then

					ValueText.Text = "None selected"
					ValueText.TextColor3 =
						Theme.TextDim

				elseif Count == 1 then

					ValueText.Text =
						tostring(
							Window.Flags[Flag][1]
						)

					ValueText.TextColor3 =
						Theme.Text

				else

					ValueText.Text =
						tostring(Count)
						.. " selected"

					ValueText.TextColor3 =
						Theme.Accent

				end

				-- Update option indicators
				for _, child in ipairs(
					OptionsHolder:GetChildren()
				) do

					if child:IsA("TextButton") then

						local Indicator =
							child:FindFirstChild(
								"Indicator"
							)

						if Indicator then

							local value =
								child:GetAttribute(
									"OptionValue"
								)

							if table.find(
								Window.Flags[Flag],
								value
							) then

								Indicator.Text = "●"
								Indicator.TextColor3 =
									Theme.Accent

							else

								Indicator.Text = "○"
								Indicator.TextColor3 =
									Theme.TextDim

							end

						end

					end

				end

			end

			--==============================================
			-- OPEN / CLOSE
			--==============================================

			local function SetOpen(State)

				Open = State

				if Open then

					local OptionHeight =
						math.max(
							#Options * ROW_HEIGHT,
							30
						)

					local ListHeight =
						OptionHeight
						+ FOOTER_HEIGHT

					local TotalHeight =
						HEADER_HEIGHT
						+ ListHeight
						+ 6

					-- Make sure list starts collapsed
					ListFrame.Size =
						UDim2.new(
							1,
							-12,
							0,
							0
						)

					ListFrame.Visible = true

					Tween(
						ListFrame,
						{
							Size = UDim2.new(
								1,
								-12,
								0,
								ListHeight
							)
						},
						0.22
					):Play()

					Tween(
						Frame,
						{
							Size = UDim2.new(
								1,
								0,
								0,
								TotalHeight
							)
						},
						0.25
					):Play()

					Tween(
						Arrow,
						{
							Rotation = 180
						},
						0.2
					):Play()

				else

					Tween(
						ListFrame,
						{
							Size = UDim2.new(
								1,
								-12,
								0,
								0
							}
						},
						0.18
					):Play()

					Tween(
						Frame,
						{
							Size = UDim2.new(
								1,
								0,
								0,
								CLOSED_HEIGHT
							)
						},
						0.22
					):Play()

					Tween(
						Arrow,
						{
							Rotation = 0
						},
						0.2
					):Play()

					task.delay(0.2, function()

						if not Open then
							ListFrame.Visible = false
						end

					end)

				end

			end

			--==============================================
			-- CREATE OPTIONS
			--==============================================

			for index, Option in ipairs(Options) do

				local Row = Create("TextButton", {
					Name = "Option_" .. tostring(index),
					Size = UDim2.new(
						1,
						0,
						0,
						ROW_HEIGHT
					),
					BackgroundColor3 =
						Theme.Background3,
					BackgroundTransparency = 1,
					Text = "",
					AutoButtonColor = false,
					LayoutOrder = index,
					Parent = OptionsHolder
				})

				Row:SetAttribute(
					"OptionValue",
					Option
				)

				--==========================================
				-- INDICATOR
				--==========================================

				local Indicator = Create("TextLabel", {
					Name = "Indicator",
					Size = UDim2.new(0, 20, 1, 0),
					Position = UDim2.new(0, 8, 0, 0),
					BackgroundTransparency = 1,
					Text =
						table.find(
							Window.Flags[Flag],
							Option
						)
						and "●"
						or "○",
					Font = Enum.Font.GothamBold,
					TextSize = 11,
					TextColor3 =
						table.find(
							Window.Flags[Flag],
							Option
						)
						and Theme.Accent
						or Theme.TextDim,
					Parent = Row
				})

				--==========================================
				-- OPTION NAME
				--==========================================

				Create("TextLabel", {
					Size = UDim2.new(
						1,
						-38,
						1,
						0
					),
					Position = UDim2.new(
						0,
						32,
						0,
						0
					),
					BackgroundTransparency = 1,
					Text = tostring(Option),
					Font = Enum.Font.Gotham,
					TextSize = 11,
					TextColor3 = Theme.Text,
					TextXAlignment =
						Enum.TextXAlignment.Left,
					TextTruncate =
						Enum.TextTruncate.AtEnd,
					Parent = Row
				})

				--==========================================
				-- HOVER
				--==========================================

				Row.MouseEnter:Connect(function()

					Tween(
						Row,
						{
							BackgroundTransparency = 0.85
						},
						0.12
					):Play()

				end)

				Row.MouseLeave:Connect(function()

					Tween(
						Row,
						{
							BackgroundTransparency = 1
						},
						0.12
					):Play()

				end)

				--==========================================
				-- SELECT
				--==========================================

				Row.MouseButton1Click:Connect(function()

					local Current =
						Window.Flags[Flag]

					local Existing =
						table.find(
							Current,
							Option
						)

					if Existing then

						table.remove(
							Current,
							Existing
						)

					else

						table.insert(
							Current,
							Option
						)

					end

					Refresh()

					if config.Callback then
						config.Callback(Current)
					end

				end)

			end

			--==============================================
			-- BUTTON EVENTS
			--==============================================

			DropBtn.MouseButton1Click:Connect(function()

				SetOpen(not Open)

			end)

			Minimize.MouseButton1Click:Connect(function()

				SetOpen(false)

			end)

			--==============================================
			-- REGISTER
			--==============================================

			table.insert(Window.AllElements, {
				Frame = Frame,
				Name = Name,
				Tab = name
			})

			Refresh()

			--==============================================
			-- RETURN OBJECT
			--==============================================

			local Object = {}

			function Object:Set(values)

				if type(values) ~= "table" then
					return
				end

				Window.Flags[Flag] = {}

				for _, value in ipairs(values) do

					if table.find(
						Options,
						value
					) then

						table.insert(
							Window.Flags[Flag],
							value
						)

					end

				end

				Refresh()

				if config.Callback then
					config.Callback(
						Window.Flags[Flag]
					)
				end

			end

			function Object:Get()
				return Window.Flags[Flag]
			end

			function Object:Open()
				SetOpen(true)
			end

			function Object:Close()
				SetOpen(false)
			end

			function Object:Toggle()
				SetOpen(not Open)
			end

			return Object

		end

